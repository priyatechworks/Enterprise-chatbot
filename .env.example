LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
AGENT_PLANNER_ENABLED=true
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
NEO4J_URI=neo4j+s://<your-aura-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-rag-change-this
NEO4J_DATABASE=neo4j
DOCLING_GRAPH_TEMPLATE=
DOC_GRAPH_PROVIDER=openai
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=30
USER_MAX_SESSIONS=5
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
GRAPH_MAX_HOPS=2
TEXT_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
VISION_EMBED_MODEL=nomic-ai/nomic-embed-vision-v1.5
CHUNK_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_CANDIDATE_K=30
MAX_UPLOAD_MB=25
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DOCLING_ENABLE_OCR=false
DOCLING_ENABLE_FORMULA_ENRICHMENT=false  # Opt in after local validation; Docling downloads formula model
DOCLING_EXTRACT_PICTURES=true
DOCLING_GENERATE_PAGE_IMAGES=false
DEMO_PASSWORD=change-this-demo-password
TOKEN_SECRET=replace-with-a-random-long-secret
